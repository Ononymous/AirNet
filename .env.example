# Supabase Configuration
# Get these values from your Supabase project settings: https://app.supabase.com
# After filling in these values, you must also update app.json with the same values
# under the "extra" field

# Your Supabase project URL (e.g., https://xxxxxxxxxxxxx.supabase.co)
SUPABASE_URL=YOUR_SUPABASE_URL_HERE

# Your Supabase project's anon/public key
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# How to set up:
# 1. Copy this file to create app.json if it doesn't exist
# 2. In app.json, under "expo" > "extra", add:
#    "supabaseUrl": "your_actual_url",
#    "supabaseAnonKey": "your_actual_key"
# 3. Never commit your actual credentials to version control
# 4. The app reads these values using Constants.expoConfig.extra.supabaseUrl

# Note: This .env.example file is for documentation purposes only.
# Expo uses app.json for configuration, not .env files.
